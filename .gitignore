# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media scratch space
tmp/
tmp/**
!tmp/uploads/.gitkeep
!tmp/exports/.gitkeep

# finished numbered exports (keep folder + readme)
exports/*
!exports/.gitkeep
!exports/README.md
!exports/**/.gitkeep

# editor project archives / previous films (keep folder + readme)
projects/*
!projects/.gitkeep
!projects/README.md

# user-dropped SFX library (keep readme)
sfx/*
!sfx/README.md
!sfx/.gitkeep

# user-dropped background music beds (keep readme)
music/*
!music/README.md
!music/.gitkeep
